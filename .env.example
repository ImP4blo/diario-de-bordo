# Copie este arquivo para ".env" e ajuste os valores.
# O .env NUNCA vai para o Git (está no .gitignore).
# Online (Render), estas mesmas variáveis ficam no painel "Environment" do serviço.

# --- Modo de uso ---
# local  = no seu PC, sem login (um usuário só)
# public = online, com login pelo Supabase (cada conta vê só o próprio diário)
APP_MODE=local

# --- Banco de dados ---
# Local: SQLite num arquivo. Online: o "Session pooler" do Supabase (botão Connect),
# com a sua senha no lugar de [YOUR-PASSWORD] (sem os colchetes):
# DATABASE_URL=postgresql://postgres.xxxxx:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./data/diario.db

# --- Login (só no modo public) ---
# Project URL e Publishable key do Supabase. Os dois são PÚBLICOS por natureza:
# o navegador usa para fazer o login. Segredo de verdade é a senha do banco.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Só para projetos antigos do Supabase que assinam tokens com segredo (HS256)
SUPABASE_JWT_SECRET=

# --- CORS (só quando o site e a API ficam em endereços diferentes) ---
# Sites que podem chamar a API, separados por vírgula. No Render, o FRONTEND_HOST
# é preenchido sozinho pelo render.yaml.
ALLOWED_ORIGINS=
FRONTEND_HOST=

# --- Usuário e fuso (modo local) ---
LOCAL_USER_ID=local
DISPLAY_NAME=Seu Nome
TIMEZONE=America/Sao_Paulo

# --- Gravação ---
# all        = salva tudo o que for reconhecido
# notes_only = salva só as frases que começam com "Diário"
SAVE_MODE=all
# Segundos de silêncio que encerram uma fala. O Chrome corta a frase a cada
# respirada; o app junta os pedaços até você ficar esse tempo calado (1 a 60)
PHRASE_GAP_SECONDS=5
# Minutos sem registro explícito até o alerta de inatividade (1 a 240).
# Dica: use 1 para testar o alerta rapidinho
INACTIVITY_MINUTES=15

# --- Rotina fixa (modo local) ---
# Copie config/routine.example.toml para config/routine.toml e edite.
# Online, cada pessoa começa com 09:00-18:00 sem blocos e ajusta na tela de Ajustes.
ROUTINE_FILE=config/routine.toml

# --- IA do app (a sua cota) ---
# Provedor: groq (plano gratuito) ou anthropic
LLM_PROVIDER=groq
# Modelo do provedor escolhido. Vazio = padrão do provedor:
#   groq      -> openai/gpt-oss-120b (lista atual: https://console.groq.com/docs/models)
#   anthropic -> claude-opus-5-5
LLM_MODEL=
# Chaves: crie em https://console.groq.com (gratuita) ou https://console.anthropic.com
# Ao gerar o diário, a transcrição do período é enviada ao provedor escolhido.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Limites diários da IA do app (só no modo public). 1 refinamento = 1 dia gerado.
# Quem usa a própria chave não entra na conta.
DAILY_REFINEMENTS_PER_USER=3
DAILY_REFINEMENTS_TOTAL=100

# --- Chave própria do usuário (Gemini) ---
# A chave é de cada pessoa e fica no navegador dela. Aqui só o modelo (vazio = padrão,
# o apelido gemini-flash-latest, com plano B no gemini-flash-lite-latest).
GEMINI_MODEL=
